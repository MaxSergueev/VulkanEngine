#version 460

layout (local_size_x = 16, local_size_y = 16) in;

// Binding 0: The sim state from the previous frame
layout(rgba16f, set = 0, binding = 0) uniform readonly image2D inputImage;

// Binding 1: The sim state being calculating now
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D outputImage;

// Binding 2: The pretty colors being written to the screen
layout(rgba16f, set = 0, binding = 2) uniform writeonly image2D displayImage;

// Push constants block
layout(push_constant) uniform constants {
    vec4 data1;  // [frame_number, screen_width, screen_height, time_factor]
    vec4 data2;  // [DA, DB, FEED, KILL]
    vec4 data3;  // [DT, SIMULATION_STEPS, unused, unused]
    vec4 data4;  // [INITIAL_SEED_OFFSET, unused, unused, unused]
} PushConstants;

// PARAMETERS
#define FRAME_NUMBER uint(PushConstants.data1.x)
#define SCREEN_WIDTH uint(PushConstants.data1.y)
#define SCREEN_HEIGHT uint(PushConstants.data1.z)
#define DA PushConstants.data2.x
#define DB PushConstants.data2.y
#define FEED PushConstants.data2.z
#define KILL PushConstants.data2.w
#define DT PushConstants.data3.x

// Boundary helper - toroidal wrap
ivec2 get_pos(int x, int y) {
    return ivec2((x + SCREEN_WIDTH) % SCREEN_WIDTH, (y + SCREEN_HEIGHT) % SCREEN_HEIGHT);
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= SCREEN_WIDTH || pos.y >= SCREEN_HEIGHT) return;

    // Initialization
    if (FRAME_NUMBER == 0) {
        float A = 1.0;
        float B = 0.0;

        // Seed some circles of Chemical B
        for (int i = 0; i < 5; i++) {
            vec2 seed_pos = vec2(SCREEN_WIDTH/5 * (i+1), SCREEN_HEIGHT/2);
            if (distance(vec2(pos), seed_pos) < 10.0) {
                B = 1.0;
            }
        }
        
        // Write the sim state
        imageStore(outputImage, pos, vec4(A, B, 0.0, 1.0));
        
        vec3 colorBg = vec3(0.25, 0.0, 0.15); // Background chemical
        vec3 colorFg = vec3(0.9, 0.2, 0.5);   // Foreground chemical  
        float bVisual = clamp(B * 3.0, 0.0, 1.0); // Use the initial B value
        vec3 finalColor = mix(colorBg, colorFg, bVisual);

        imageStore(displayImage, pos, vec4(finalColor, 1.0));
    } 
    // SIMULATION STEP
    else {
        // Read the center value from the INPUT image
        vec4 center_val = imageLoad(inputImage, pos);
        float A = center_val.x;
        float B = center_val.y;

        // Calculate Laplacian (Diffusion) using the INPUT image neighbors
        vec2 sum = vec2(0.0);
        
        // Adjacent neighbors (weight 0.2)
        sum += imageLoad(inputImage, get_pos(pos.x - 1, pos.y)).xy * 0.2;
        sum += imageLoad(inputImage, get_pos(pos.x + 1, pos.y)).xy * 0.2;
        sum += imageLoad(inputImage, get_pos(pos.x, pos.y - 1)).xy * 0.2;
        sum += imageLoad(inputImage, get_pos(pos.x, pos.y + 1)).xy * 0.2;
        
        // Diagonal neighbors (weight 0.05)
        sum += imageLoad(inputImage, get_pos(pos.x - 1, pos.y - 1)).xy * 0.05;
        sum += imageLoad(inputImage, get_pos(pos.x + 1, pos.y - 1)).xy * 0.05;
        sum += imageLoad(inputImage, get_pos(pos.x - 1, pos.y + 1)).xy * 0.05;
        sum += imageLoad(inputImage, get_pos(pos.x + 1, pos.y + 1)).xy * 0.05;
        
        // Laplacian = weighted sum - current center
        vec2 lap = sum - vec2(A, B);
        
        // Gray-Scott Formulas
        float reaction = A * B * B;
        float nextA = A + (DA * lap.x - reaction + FEED * (1.0 - A)) * DT;
        float nextB = B + (DB * lap.y + reaction - (KILL + FEED) * B) * DT;
        
        // Clamp for stability
        nextA = clamp(nextA, 0.0, 1.0);
        nextB = clamp(nextB, 0.0, 1.0);

        // 1. Write the sim result to the OUTPUT simulation image
        imageStore(outputImage, pos, vec4(nextA, nextB, 0.0, 1.0));
        
        // 2. Translate the sim colors and write to DISPLAY image
        vec3 colorBg = vec3(0.25, 0.0, 0.15); // Background chemical
        vec3 colorFg = vec3(0.9, 0.2, 0.5);   // Foreground chemical
        
        // Increase the visual contrast of B slightly
        float bVisual = clamp(nextB * 3.0, 0.0, 1.0); 
        vec3 finalColor = mix(colorBg, colorFg, bVisual);

        imageStore(displayImage, pos, vec4(finalColor, 1.0));
    }
}